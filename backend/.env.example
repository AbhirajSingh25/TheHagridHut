# ============================================================
# HireSense AI backend - environment configuration
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# ============================================================

# --- Database ---
# Postgres connection string (Neon, Supabase, RDS, local Postgres, etc).
# SQLite also works for local development, e.g.:
#   DATABASE_URL=sqlite:///./hiresense.db
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Auth / JWT ---
# Long, random secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
# The origin your frontend is served from. The backend also always
# allows http://localhost:5173 and http://127.0.0.1:5173 (Vite's
# default dev server) regardless of this value.
FRONTEND_URL=http://localhost:5173

# --- AI provider (Groq) ---
# Used for resume analysis, interview question generation/evaluation,
# speech transcription + analysis, vision analysis, AI copilot, etc.
# Get a key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# --- Server ---
# Only used by the Dockerfile / hosting platform; uvicorn defaults to
# 8000 locally if unset.
PORT=8000
